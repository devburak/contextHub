# ContextHub Cloud production admin API.
# Copy this file to .env.production or provide the value in the build environment.
VITE_API_URL=https://api.ctxhub.net/api

# Public Paddle client-side token; publish only after the live account and ctxhub.net
# domain are approved. This is intentionally not a server API key or webhook secret.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=live
