{
  "name": "@contexthub/api",
  "version": "0.1.58",
  "private": true,
  "description": "Fastify back‑end service for contextHub",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "dev:watch": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "echo \"API build completed - production ready\"",
    "test": "node ../../scripts/run-tool.mjs vitest run --dir src",
    "test:watch": "node ../../scripts/run-tool.mjs vitest --dir src",
    "lint": "node ../../scripts/run-tool.mjs eslint . --ext .js,.ts",
    "lint:fix": "node ../../scripts/run-tool.mjs eslint . --ext .js,.ts --fix",
    "format": "node ../../scripts/run-tool.mjs prettier --write .",
    "format:check": "node ../../scripts/run-tool.mjs prettier --check .",
    "clean": "rm -rf dist .turbo",
    "type-check": "echo \"No TypeScript in API yet\"",
    "db:seed": "node scripts/seed.js",
    "db:bootstrap": "node src/scripts/bootstrapCore.js",
    "db:migrate": "node scripts/migrate.js",
    "db:backfill-subscriptions": "node src/scripts/backfillTenantSubscriptions.js",
    "db:backfill-accounts": "node src/scripts/backfillTenantAccounts.js",
    "db:backfill-enterprise-commercial": "node src/scripts/backfillEnterpriseCommercialAssurance.js",
    "db:backfill-domain-event-sequences": "node scripts/backfill-domain-event-sequences.js",
    "cron:consumers": "node scripts/consumer-cron.js",
    "cron:tenant-purge": "node src/scripts/purgeDeletedTenants.js",
    "cron:form-uploads": "node src/scripts/cleanupFormUploads.js",
    "db:migrate-tenant-provisioning": "node src/scripts/dropLegacySelfServiceTenantIndex.js",
    "db:seed-plans": "node src/scripts/seedSubscriptionPlans.js",
    "db:seed-flags": "node src/scripts/seedFeatureFlags.js",
    "edge:sync-kv": "node src/scripts/syncEdgeGatewayKv.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@contexthub/common": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^16.4.2",
    "nodemailer": "^10.3.1",
    "otpauth": "9.6.0",
    "redis": "^5.12.1",
    "semver": "7.8.5",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
